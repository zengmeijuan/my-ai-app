# ============================================================
# 复制此文件为 .env 并填入真实 API Key
#   Git Bash:   cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
#
# 然后取消注释其中一个方案，填入 Key
# ============================================================

# ---------- 方案 1：OpenAI 官方 ----------
# 国内访问可能需要代理
API_KEY=sk-你的OpenAI-Key
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# ---------- 方案 2：DeepSeek（推荐，国内可访问 + 新用户送 500 万 token）----------
# 注册: https://platform.deepseek.com/
# API_KEY=sk-你的-DeepSeek-Key
# BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# ---------- 方案 3：智谱 GLM ----------
# 注册: https://open.bigmodel.cn/
# API_KEY=你的-智谱-Key
# BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4-flash

# ---------- 方案 4：月之暗面 Kimi ----------
# 注册: https://platform.moonshot.cn/
# API_KEY=sk-你的-Kimi-Key
# BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-8k
