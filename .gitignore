# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# IDE workspace files (PyCharm/IntelliJ personal config)
.idea/

# Virtual environments
.venv

# Environment variables (contains API keys)
.env
.env.local

# RAG index (rebuildable from docs/ via: uv run python rag.py build)
rag_index.json

# Agent runtime state (session memory + long-term memory)
# session.json: messages 磁盘快照，可能含完整对话历史
# memory.md: 长期记忆文件，可能含敏感信息（过敏、密码、个人偏好），提交会泄露
session.json
memory.md

# H1 示例业务库（db_seed.build 幂等重建的生成物，不进版本库）
shop.db

# H5 结构化日志（运行观测数据，逐条 JSON；聚合查询的数据源）
server.jsonl

# 本地 Claude skills 安装物（工作类工具装进了项目 .claude，与本项目无关不进库）
.claude/skills/
